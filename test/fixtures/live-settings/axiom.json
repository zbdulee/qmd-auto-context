{
  "indexing": true,
  "name": "axiom",
  "collections": [
    "axiom-current-docs",
    "axiom-pc-qa",
    "axiom-plans",
    "axiom-codex"
  ],
  "collectionPaths": {
    "axiom-current-docs": "docs/current",
    "axiom-pc-qa": "docs/product-open/pc-web",
    "axiom-plans": "docs/plans",
    "axiom-codex": ".codex"
  },
  "skipPaths": [
    ".git",
    "node_modules",
    "server/node_modules",
    "mobile/AxiomApp/Library",
    "mobile/AxiomApp/Temp",
    "mobile/AxiomApp/Logs",
    "mobile/AxiomApp/obj",
    "dist",
    "build",
    "output",
    ".worktrees",
    "graphify-out",
    ".serena",
    ".zb-context",
    "coverage",
    ".next",
    ".vite"
  ],
  "minScore": 0.5,
  "topN": 3,
  "queryTimeout": 3,
  "prefixStyle": "tag",
  "events": [
    "sessionStart",
    "userPromptSubmit",
    "postToolUse"
  ]
}
